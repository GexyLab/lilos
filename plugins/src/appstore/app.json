{
  "id": "appstore",
  "version": "1.11.0",
  "kind": "local",
  "name": "AppStore",
  "description": "Installs, updates and removes apps and kernel modules from repositories; checks for updates even with lilOS closed.",
  "category": "system",
  "icon": { "glyph": "download", "color": "#30a46c" },
  "publisher": { "id": "lilos", "name": "lilOS" },
  "sdk": "1",
  "system": true,
  "required": true,
  "lilos": ">=1.22.0",
  "entrypoints": { "updates": { "kind": "service", "file": "dist/updates.js", "label": "Updates", "params": {
    "ore": { "type": "number", "label": "Check every (hours)", "min": 1, "max": 168, "default": 24 }
  } } },
  "permissions": ["apps.manage", "background"],
  "contributes": { "window": { "width": 860, "height": 600 } }
}
