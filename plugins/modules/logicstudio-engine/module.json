    "maxSchemas": 20,
    "maxWindows": 10,
    "maxComponents": 200,
    "maxProjectLinks": 200,
    "maxAddedPorts": 32,
    "maxConsoles": 10,
    "consoleLinesPerSecond": 50,
    "chartPoints": 1000,
